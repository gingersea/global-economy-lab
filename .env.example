# ─────────────────────────────────────────────────────────
# API Keys – ALL OPTIONAL
# ─────────────────────────────────────────────────────────
#
# The project runs end-to-end without any API key.  US macro and bond
# series are fetched from FRED's public CSV endpoint (fred_csv backend)
# and the US Treasury's Daily Par Yield Curve CSV; global macro uses the
# World Bank and ECB SDW open APIs.  Setting FRED_API_KEY merely enables
# the (legacy) `fredapi` fallback path.

# FRED API Key – OPTIONAL.  Free signup at
# https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=your_fred_api_key_here

# ─────────────────────────────────────────────────────────
# Optional Keys (reserved for future expansion)
# ─────────────────────────────────────────────────────────

# Alpha Vantage API Key (optional)
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Quandl / Nasdaq Data Link API Key (optional)
# QUANDL_API_KEY=your_quandl_key_here

# ─────────────────────────────────────────────────────────
# Project Settings (overrides defaults in config/settings.py)
# ─────────────────────────────────────────────────────────

# Where to store local data cache (default: ./data)
# DATA_DIR=./data

# Logging level: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# HTTP request timeout in seconds (default: 30)
# REQUEST_TIMEOUT=30

# Number of retries on failed requests (default: 3)
# MAX_RETRIES=3
