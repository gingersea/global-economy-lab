*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# ── Virtual environments ─────────────────────────────────────
.venv/
venv/
env/
.env
ENV/

# ── Jupyter ──────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── pytest / coverage ────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ── mypy / type checkers ─────────────────────────────────────
.mypy_cache/
